ANTHROPIC_API_KEY=

# REQUIRED — signing key for session tokens. Must be a dedicated random
# string of at least 32 characters (NOT a human password). The server
# refuses to boot without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_HMAC_SECRET=

BETA_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=3001

# OAuth 2.1 authorization server (P5-51) — what lets ChatGPT's custom
# connectors and Claude's remote connectors reach POST /mcp; neither can
# carry a personal token. Set this to the API's OWN public https origin
# (e.g. https://api.example.com) — no path, no trailing slash. It doubles
# as the base of the MCP resource identifier ($OAUTH_ISSUER/mcp), and it's
# read from this env rather than derived from the request's Host header
# because a forged Host would otherwise redirect a connector's whole flow
# elsewhere. Must be https, except on localhost/127.0.0.1 for local dev.
# Leave unset to simply disable OAuth: the OAuth endpoints answer 503 and
# personal tokens keep working exactly as before. See docs/MCP.md.
# OAUTH_ISSUER=https://api.example.com

# Set on every production deployment. Hardens error responses and
# force-disables BUDGET_BYPASS.
# NODE_ENV=production

# Number of proxy hops between the client and this server (Express
# `trust proxy`). 1 = single proxy (Railway/Render direct), 2 = CDN in
# front of that. Must match the real topology or per-IP limits are
# spoofable. Defaults to 1.
# TRUST_PROXY_HOPS=1

# Optional Postgres connection string for the usage dashboard (/dashboard).
# When set, per-request usage is persisted and survives redeploys; when
# unset, the dashboard still works but only shows data since the last
# restart. Any managed Postgres works (Neon/Railway/Render/Supabase).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Daily token budget guards (defaults: 200_000 total, 15_000 per IP).
# Override only if you know what you're changing.
# DAILY_BUDGET_TOKENS=200000
# DAILY_BUDGET_TOKENS_PER_IP=15000

# Per-user ceiling on the internal library endpoints, per minute
# (default 120 — far above the app's own burst, far below what pins the
# box). Read per request, so it can also be pinned low for one test.
# INTERNAL_RATE_LIMIT_MAX=120

# Local-dev escape hatch — disables both daily caps so local testing
# isn't blocked by the per-IP 15k limit. Usage is still recorded for
# observability, but limits are not enforced. Ignored (with a warning)
# when NODE_ENV=production.
# BUDGET_BYPASS=true

# Staging-tier password. When set, users who POST this value to
# /api/auth receive a `staging`-tier token that bypasses the daily
# cap. Lets PM testers exercise the conversational layer on a shared
# backend without burning into the prod token budget. Leave unset on
# pure-prod deployments — the upgrade path simply won't exist.
# A staging-tier token is also what unlocks GET /api/health/usage.
# STAGING_PASSWORD=

# Document text extraction (P5-46). After every reindex the server pulls the
# text out of PDFs, Word, RTF and plain-text files in document/incoming
# entries (and dataset READMEs) and stores it in the bucket under
# library/derived/, so Ask can cite them by page and the viewer can show a
# Word file's words. Both caps protect the box the public map shares.
# EXTRACT_MAX_BYTES=20971520
# EXTRACT_MAX_PAGES=400

# Fetching a source for a place (P5-57). A source entry indexes a dataset we
# do not hold; these two cap the outbound request that fetches one place's
# worth of it. Every such request already goes through the host guard (public
# addresses only, re-checked per redirect) and a per-source limit of 30
# requests a minute, so these are about weight and patience, not safety.
# PLACE_FETCH_TIMEOUT_MS=30000
# PLACE_FETCH_MAX_BYTES=26214400

# User-Agent sent to Nominatim when an address falls through the Census
# geocoder (P5-23, reused by P5-57). Their policy asks for a real contact.
# GEOCODE_USER_AGENT=BLO-library-geocode/1.0 (you@example.org)
